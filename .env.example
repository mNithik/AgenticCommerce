# =============================================================================
# ProofSpend — copy this file to .env on every new machine:
#   cp .env.example .env   (or Copy-Item on Windows)
# =============================================================================

# --- Payment mode ---
# true  = mock receipts, no USDC (default for dev / another laptop)
# false = real Tavily x402 on Base (~$0.01 per search)
MOCK_X402=true

TAVILY_X402_URL=https://x402.tavily.com/search
# Live only: wallet that signs x402 payments (local demo — do not deploy to public hosting)
AGENT_WALLET_KEY=
# Max USDC per search in atomic units (6 decimals): 20000 = $0.02 cap
AWAL_MAX_AMOUNT=20000

# --- LLM: nvidia | openai | huggingface | deterministic ---
# deterministic = no API key (works offline with MOCK_X402)
LLM_PROVIDER=deterministic

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_SUMMARY=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_ANALYST=meta/llama-3.1-8b-instruct

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL_SUMMARY=gpt-4o-mini
OPENAI_MODEL_ANALYST=gpt-4o-mini

# Hugging Face Inference (optional; small free tier)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL_SUMMARY=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_ANALYST=meta-llama/Llama-3.1-8B-Instruct
